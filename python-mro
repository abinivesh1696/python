1)How does Python resolve method calls when a class inherits from multiple parent classes that share a common ancestor (known as the Diamond Inheritance problem), and how can you programmatically check this lookup order?


class Base:
    def process(self):
        print("Entering Base")
        print("Leaving Base")

class Left(Base):
    def process(self):
        print("Entering Left")
        super().process()  # Python looks at the MRO chain to find the next class
        print("Leaving Left")

class Right(Base):
    def process(self):
        print("Entering Right")
        super().process()
        print("Leaving Right")

class Child(Left, Right):
    def process(self):
        print("Entering Child")
        super().process()
        print("Leaving Child")


2) How do you create a Python decorator that accepts arguments (like a custom prefix or a repeat count), and what does the structural code look like?

import functools

def repeat(num_times):
    """Top-level function to accept decorator arguments."""
    def decorator_repeat(func):
        """The actual decorator that accepts the target function."""
        @functools.wraps(func) # Preserves original function identity and docstrings
        def wrapper(*args, **kwargs):
            """The inner wrapper that executes the custom logic."""
            for _ in range(num_times):
                result = func(*args, **kwargs)
            return result
        return wrapper
    return decorator_repeat


